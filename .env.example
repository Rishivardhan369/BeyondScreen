DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=example.com,www.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
DJANGO_STATIC_ROOT=
DJANGO_LOG_LEVEL=WARNING
# Enable only when your trusted reverse proxy sets X-Forwarded-Proto.
DJANGO_TRUST_PROXY_SSL_HEADER=False

# Optional SMTP password-reset delivery (console output is the safe default).
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=BeyondScreen <no-reply@example.com>

# Optional PostgreSQL configuration. Omit DB_ENGINE to keep local SQLite.
DB_ENGINE=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
DJANGO_MEDIA_ROOT=
BEYONDSCREEN_DEVICE_API_REQUIRE_HTTPS=True
# Real push delivery is disabled until a deployment-owned provider/credential is configured.
FCM_CREDENTIALS_PATH=
